<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Dashboard Etos ID Palu</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
<script>tailwind.config={theme:{extend:{colors:{etos:{main:'#155e3f',light:'#e8f3ee',hover:'#1a754f'},app:{bg:'#f4f7f6',card:'#fff'}},fontFamily:{sans:['Inter','sans-serif']}}}}</script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
body{background:#e2e8f0;color:#1e293b;font-family:Inter,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;overflow:hidden}.app-wrapper{background:#f4f7f6;width:100%;height:100%;display:flex;overflow:hidden;box-shadow:0 25px 50px -12px rgba(0,0,0,.1)}@media(min-width:1024px){.app-wrapper{width:98vw;height:96vh;border-radius:2rem}}.no-scrollbar::-webkit-scrollbar{display:none}.no-scrollbar{scrollbar-width:none}.card-clean{background:#fff;border:1px solid #f1f5f9;border-radius:1.5rem;box-shadow:0 4px 20px -2px rgba(0,0,0,.03)}.card-primary{background:#155e3f;color:#fff;border-radius:1.5rem;box-shadow:0 10px 25px -5px rgba(21,94,63,.4)}.z-hide{display:none!important}.view{animation:fade .25s ease both}@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}.pill{display:inline-flex;padding:.25rem .65rem;border-radius:999px;font-size:10px;font-weight:800}.input-clean{width:100%;background:#f8fafc;border:1px solid #e2e8f0;border-radius:.75rem;padding:.65rem 1rem;font-size:.875rem;outline:none}.input-clean:focus{border-color:#155e3f;box-shadow:0 0 0 3px rgba(21,94,63,.1)}
</style>
</head>
<body class="antialiased">
<div id="loader" class="fixed top-0 inset-x-0 z-[9999] h-[3px] bg-green-100 z-hide"><div class="h-full bg-etos-main animate-pulse w-1/2"></div></div>
<div class="app-wrapper relative">
<div id="backdrop" class="fixed inset-0 bg-slate-950/35 z-40 hidden lg:hidden" onclick="toggleSidebar(false)"></div>
<aside id="sidebar" class="w-72 lg:w-64 max-w-[86vw] bg-white flex-shrink-0 flex flex-col absolute lg:relative z-50 h-full -translate-x-full lg:translate-x-0 transition-transform border-r border-slate-100 shadow-2xl lg:shadow-none">
  <div class="px-8 py-8 flex justify-between items-center"><div class="flex items-center gap-2"><img src="https://lh3.googleusercontent.com/d/1x-5BQAUqRP7zHBmLWGYaB-Jsurdpn5XI" class="h-8 w-auto object-contain" onerror="this.src='https://ui-avatars.com/api/?name=Etos+ID&background=155e3f&color=fff&rounded=true'"><h1 class="text-xl font-extrabold text-slate-800">Etos ID Palu</h1></div><button class="lg:hidden" onclick="toggleSidebar(false)"><i data-lucide="x"></i></button></div>
  <nav class="flex-1 overflow-y-auto no-scrollbar py-2 px-6 space-y-1">
    <p class="px-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4">MENU</p>
    <button data-v="dashboard" class="nav w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-etos-main bg-green-50/50 font-bold text-sm"><i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard</button>
    <button data-v="directory" class="nav w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-500 hover:bg-slate-50 font-medium text-sm"><i data-lucide="users" class="w-4 h-4"></i> Direktori</button>
    <button data-v="alumni" class="nav w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-500 hover:bg-slate-50 font-medium text-sm"><i data-lucide="graduation-cap" class="w-4 h-4"></i> Tracking Alumni</button>
    <p class="px-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4 mt-8">MONITORING</p>
    <button data-v="akademik" class="nav w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-500 hover:bg-slate-50 font-medium text-sm"><i data-lucide="graduation-cap" class="w-4 h-4"></i> Akademik</button>
    <button data-v="absensi" class="nav w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-500 hover:bg-slate-50 font-medium text-sm"><i data-lucide="calendar-check" class="w-4 h-4"></i> Absensi</button>
    <button data-v="coaching" class="nav w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-500 hover:bg-slate-50 font-medium text-sm"><i data-lucide="messages-square" class="w-4 h-4"></i> Coaching & IDP</button>
    <button data-v="asesmen" class="nav w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-500 hover:bg-slate-50 font-medium text-sm"><i data-lucide="brain-circuit" class="w-4 h-4"></i> Asesmen & Development</button>
    <button data-v="prestasi" class="nav w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-500 hover:bg-slate-50 font-medium text-sm"><i data-lucide="award" class="w-4 h-4"></i> Prestasi</button>
  </nav>
  <div class="px-6 pb-8"><div class="bg-gradient-to-br from-[#0f2d1e] to-[#0a1e14] rounded-3xl p-5 text-white shadow-xl"><div class="flex items-center gap-2"><div class="bg-white/10 p-1.5 rounded-lg"><i data-lucide="shield-check" class="w-4 h-4 text-green-300"></i></div><h4 class="font-bold text-sm">Admin Access</h4></div><button data-v="profil" class="nav mt-4 w-full bg-etos-main hover:bg-etos-hover text-xs font-bold py-2.5 rounded-xl">Fasilitator Profil</button></div></div>
</aside>
<main class="flex-1 flex flex-col h-full overflow-hidden bg-[#f4f7f6] min-w-0">
<header class="px-6 md:px-10 py-6 flex items-center justify-between flex-shrink-0"><div class="flex items-center gap-4 w-full max-w-xl"><button class="lg:hidden w-11 h-11 rounded-full hover:bg-white" onclick="toggleSidebar(true)"><i data-lucide="menu"></i></button><div class="relative w-full hidden md:block"><i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4"></i><input id="globalSearch" oninput="renderCurrent()" placeholder="Search task or data.