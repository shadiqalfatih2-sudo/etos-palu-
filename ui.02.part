/h3><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4">${S.awardees.filter(a=>String(a.status).toLowerCase()==='aktif').slice(0,6).map(a=>`<button onclick="openProfile('${esc(a.id)}')" class="text-left p-4 rounded-2xl border border-slate-100 hover:border-green-200 hover:bg-green-50/30"><p class="font-extrabold text-sm">${esc(a.nama)}</p><p class="text-xs text-slate-500 mt-1">${esc(a.kampus)} • ${esc(a.angkatan)}</p><p class="text-xs font-bold text-etos-main mt-3">IPK ${fmt(a.ipk)}</p></button>`).join('')}</div></section><section class="card-clean p-5"><h3 class="font-extrabold">Data Health</h3><div class="space-y-3 mt-4 text-sm"><div class="flex justify-between"><span>Total Awardee</span><b>${fmt(S.stats?.totalAwardee)}</b></div><div class="flex justify-between"><span>Rata-rata IPK</span><b>${fmt(S.stats?.avgIPK)}</b></div><div class="flex justify-between"><span>Prestasi</span><b>${S.achievements.length}</b></div><div class="flex justify-between"><span>Runtime</span><b class="text-etos-main">Direct Supabase</b></div></div></section></div>`}
function directory(){let q=query(),rows=S.awardees.filter(a=>!q||[a.nama,a.kampus,a.jurusan,a.id].join(' ').toLowerCase().includes(q));return head('Direktori Awardee','Database awardee ETOS ID Palu.',`<button class="bg-etos-main text-white px-5 py-2.5 rounded-full text-sm font-bold">+ Add Awardee</button>`)+`<div class="card-clean overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-left"><thead class="bg-slate-50 text-[11px] text-slate-500 uppercase"><tr><th class="px-6 py-4">Nama</th><th class="px-6 py-4">Kampus & Jurusan</th><th class="px-6 py-4">Status</th><th></th></tr></thead><tbody class="divide-y divide-slate-100">${rows.map(a=>`<tr class="hover:bg-slate-50/50"><td class="px-6 py-4"><div class="flex gap-3 items-center"><img src="${esc(a.foto)||'https://ui-avatars.com/api/?name='+encodeURIComponent(a.nama)+'&background=155e3f&color=fff'}" class="w-10 h-10 rounded-xl object-cover"><div><button onclick="openProfile('${esc(a.id)}')" class="font-bold text-sm hover:text-etos-main">${esc(a.nama)}</button><p class="text-xs text-slate-400">ID: ${esc(a.id)}</p></div></div></td><td class="px-6 py-4"><p class="text-sm font-bold">${esc(a.kampus)}</p><p class="text-xs text-slate-400">${esc(a.jurusan)} (Angkatan ${esc(a.angkatan)})</p></td><td class="px-6 py-4"><span class="pill ${String(a.status).toLowerCase()==='aktif'?'bg-green-50 text-etos-main':'bg-slate-100 text-slate-600'}">${esc(a.status)}</span></td><td class="px-6 py-4 text-right"><button onclick="openProfile('${esc(a.id)}')"><i data-lucide="chevron-right" class="w-4 h-4"></i></button></td></tr>`).join('')}</tbody></table></div></div>`}
async function alumni(){const list=await call('getAlumniList');return head('Tracking Alumni','Jejak kontribusi dan portofolio alumni ETOS ID Palu.')+`<div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-5">${list.map(a=>`<div class="card-clean p-6"><div class="flex justify-between"><img src="${esc(a.foto)||'https://ui-avatars.com/api/?name='+encodeURIComponent(a.nama)+'&background=155e3f&color=fff'}" class="w-16 h-16 rounded-2xl object-cover"><span class="pill bg-slate-100 text-slate-600">Angkatan ${esc(a.angkatan)}</span></div><h4 class="font-extrabold mt-4">${esc(a.nama)}</h4><p class="text-xs text-slate-400 mt-1">${esc(a.kampus)} • ${esc(a.jurusan)}</p><div class="mt-4 pt-3 border-t"><p class="text-[10px] font-bold text-slate-400 uppercase">Kontribusi saat ini</p><p class="text-xs font-semibold mt-1">${esc(a.kontribusi||'Belum diperbarui')}</p></div></div>`).join('')}</div>`}
function akademik(){let q=query(),rows=S.academic.filter(a=>!q||String(a.nama).toLowerCase().includes(q));return head('Monitoring Akademik','Riwayat KHS dan IPK awardee.')+tableCard(['Nama','Semester','IPK'],rows.map(a=>[a.nama,a.smt,Number(a.ipk||0).toFixed(2)]))}
function prestasi(){let q=query(),rows=S.achievements.filter(a=>!q||[a.nama,a.prestasi].join(' ').toLowerCase().includes(q));return head('Prestasi','Achievement tracker awardee ETOS ID Palu.',`<button class="bg-etos-main text-white px-5 py-2.5 rounded-full text-sm font-bold">+ Catat Prestasi</button>`)+tableCard(['Nama','Prestasi','Tahun','Tingkat'],rows.map(a=>[a.nama,a.prestasi,a.tahun,a.tingkat]))}
function tableCard(h,rows){return `<div class="card-clean overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-slate-400 text-xs"><tr>${h.map(x=>`<th class="px-6 py-4">${x}</th>`).join('')}</tr></thead><tbody class="divide-y divide-slate-100">${rows.length?rows.map(r=>`<tr>${r.map(c=>`<td class="px-6 py-4">${esc(fmt(c))}</td>`).join('')}</tr>`).join(''):`<tr><td colspan="${h.length}">${empty('Belum ada data.')}</td></tr>`}</tbody></table></div></div>`}
function absensi(){return head('Absensi & Pembinaan','Kehadiran kajian, tahsin, dan agenda pembinaan.')+`<div class="grid sm:grid-cols-3 gap-5">${stat('Periode Aktif',0,'calendar-range',true,'Periode baru siap dibuat')}${stat('Agenda',0,'calendar-days',false,'Belum ada agenda aktif')}${stat('Kehadiran',0,'user-check',false,'Belum ada presensi')}</div><div class="card-clean mt-5 p-8">${empty('Data periode/agenda lama telah dikosongkan untuk periode pembinaan baru. Struktur modul tetap siap digunakan.')}</div>`}
async function coaching(){const idp=await call('getIDPOverview');return head('Coaching & IDP','Pendampingan, Individual Development Plan, dan perkembangan awardee.')+`<div class="grid sm:grid-cols-3 gap-5">${stat('Awardee Aktif',idp.totalActive,'users',true,'Pendampingan aktif')}${stat('IDP Terhubung',idp.connected,'link',false,'Snapshot Supabase')}${stat('Belum Terhubung',idp.missing,'unlink',false,'Perlu sinkronisasi')}</div><div class="card-clean mt-5 overflow-hidden"><div class="p-5 border-b"><h3 class="font-extrabold">Individual Development Plan</h3><p class="text-xs text-slate-500 mt-1">Status data IDP awardee aktif.</p></div>${tableCardInner(['Nama','Angkatan','Status'],idp.items.map(x