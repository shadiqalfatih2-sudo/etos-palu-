=>[x.nama,x.angkatan,x.connected?'Terhubung':'Belum terhubung']))}</div>`}
function tableCardInner(h,rows){return `<div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-slate-50 text-slate-400"><tr>${h.map(x=>`<th class="px-6 py-4 text-left">${x}</th>`).join('')}</tr></thead><tbody class="divide-y">${rows.map(r=>`<tr>${r.map(c=>`<td class="px-6 py-4">${esc(c)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`}
async function asesmen(){const h=await call('getAssessmentHub');return head('Asesmen & Development','Mengenal diri, memahami diri, dan menentukan arah pengembangan.')+`<div class="grid sm:grid-cols-3 gap-5">${['Mengenal Diri','Memahami Diri','Menentukan Arah'].map((x,i)=>`<div class="card-clean p-6"><div class="w-11 h-11 rounded-2xl bg-green-50 text-etos-main flex items-center justify-center"><i data-lucide="${['fingerprint','brain','compass'][i]}" class="w-5 h-5"></i></div><p class="text-[10px] font-extrabold text-etos-main mt-5">0${i+1}</p><h3 class="text-lg font-extrabold mt-1">${x}</h3><p class="text-xs text-slate-500 mt-2">Modul asesmen perkembangan awardee.</p></div>`).join('')}</div><div class="card-clean mt-5 p-6"><h3 class="font-extrabold">Assessment Hub</h3><p class="text-sm text-slate-500 mt-2">${h.awardees.length} awardee aktif tersedia untuk asesmen.</p></div>`}
function profil(){return head('Profil Fasilitator Wilayah','Identitas dan akses fasilitator ETOS ID Palu.')+`<div class="card-clean p-8 max-w-3xl"><div class="flex items-center gap-4 border-b pb-5"><img src="https://ui-avatars.com/api/?name=FA&background=155e3f&color=fff" class="w-16 h-16 rounded-full"><div><h3 class="text-xl font-bold">Fasilitator ETOS ID Palu</h3><p class="text-sm text-slate-500">Palu</p></div></div><div class="mt-6 grid md:grid-cols-2 gap-4"><div><label class="text-sm font-semibold">Nama Lengkap</label><input class="input-clean mt-1" value="Fasilitator ETOS ID Palu" readonly></div><div><label class="text-sm font-semibold">Runtime</label><input class="input-clean mt-1" value="Vercel + Direct Supabase" readonly></div></div></div>`}
async function openProfile(id){loading(true);try{const p=await call('getAwardeeProfile',id),ak=S.academic.filter(x=>x.awdId===id);document.getElementById('content').innerHTML=head('Profil Awardee','Awardee Development 360°',`<button onclick="setView('directory')" class="bg-white border px-4 py-2 rounded-full text-sm font-bold">← Kembali</button>`)+`<div class="card-clean p-8"><div class="flex flex-col md:flex-row gap-6"><img src="${esc(p.foto)||'https://ui-avatars.com/api/?name='+encodeURIComponent(p.nama)+'&background=155e3f&color=fff'}" class="w-32 h-32 rounded-3xl object-cover"><div><div class="flex gap-3 items-center"><h3 class="text-3xl font-extrabold">${esc(p.nama)}</h3><span class="pill bg-green-50 text-etos-main">${esc(p.status)}</span></div><p class="text-sm text-slate-600 mt-2">${esc(p.kampus)} • ${esc(p.jurusan)} • Angkatan ${esc(p.angkatan)}</p><div class="bg-slate-50 border-l-4 border-etos-main p-4 rounded-r-xl mt-5"><p class="text-[10px] font-bold text-slate-400 uppercase">Visi Hidup / Motto</p><p class="text-sm italic mt-1">${esc(p.motto||'Belum tersedia')}</p></div></div></div></div><div class="grid lg:grid-cols-3 gap-5 mt-5"><div class="card-clean p-6"><h4 class="font-extrabold">Statistik Absensi</h4>${empty('Belum ada periode aktif.')}</div><div class="card-clean p-6"><h4 class="font-extrabold">Riwayat KHS</h4>${tableCardInner(['Semester','IPK'],ak.map(x=>[x.smt,Number(x.ipk||0).toFixed(2)]))}</div><div class="card-clean p-6"><h4 class="font-extrabold">Organisasi</h4>${empty('Data organisasi akan dimuat melalui Auth/RLS.')}</div></div>`;lucide.createIcons()}catch(e){document.getElementById('content').innerHTML=errorBox(e.message)}finally{loading(false)}}
async function render(){loading(true);try{let html;if(S.view==='dashboard')html=dashboard();else if(S.view==='directory')html=directory();else if(S.view==='alumni')html=await alumni();else if(S.view==='akademik')html=akademik();else if(S.view==='absensi')html=absensi();else if(S.view==='coaching')html=await coaching();else if(S.view==='asesmen')html=await asesmen();else if(S.view==='prestasi')html=prestasi();else html=profil();document.getElementById('content').innerHTML=`<div class="view w-full max-w-7xl mx-auto">${html}</div>`;lucide.createIcons()}catch(e){document.getElementById('content').innerHTML=errorBox(e.message)}finally{loading(false)}}
function renderCurrent(){if(['directory','akademik','prestasi'].includes(S.view))render()}
async function refreshAll(){loading(true);try{await window.etosSupabaseDirect.refresh();await boot()}finally{loading(false)}}
window.addEventListener('etos-direct-loaded',e=>{const m=e.detail?.ms;if(m!=null){document.getElementById('ms').textContent=m+' ms';document.getElementById('perf').classList.remove('hidden')}});
window.onerror=(m,s,l)=>{console.error(m,s,l)};lucide.createIcons();boot();
</script></body></html>
