.." class="w-full max-w-md bg-white border border-slate-100 rounded-full pl-12 pr-5 py-3 text-sm font-medium shadow-sm outline-none"></div></div><div class="flex items-center gap-3"><div id="perf" class="hidden xl:flex items-center gap-2 bg-white border border-emerald-100 text-emerald-700 rounded-full px-3 py-2 text-[10px] font-extrabold shadow-sm"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> DIRECT <span id="ms" class="font-mono">— ms</span></div><button class="w-10 h-10 bg-white rounded-full border border-slate-100 shadow-sm text-slate-400 hidden sm:flex items-center justify-center"><i data-lucide="bell" class="w-4 h-4"></i></button><div class="h-6 w-px bg-slate-200 hidden sm:block"></div><div class="flex items-center gap-3"><div class="hidden md:block text-right"><p id="topName" class="text-sm font-bold text-slate-800">Fasilitator</p><p class="text-[11px] text-slate-500">ETOS ID Palu</p></div><img src="https://ui-avatars.com/api/?name=FA&background=155e3f&color=fff" class="w-10 h-10 rounded-full border-2 border-white"></div></div></header>
<div id="content" class="flex-1 overflow-y-auto px-4 md:px-10 pb-10 no-scrollbar"></div>
</main></div>
<script src="/supabase-direct.js"></script>
<script>
const S={view:'dashboard',stats:null,awardees:[],academic:[],achievements:[],cmd:null};
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=x=>x==null||x===''?'-':x;
function toggleSidebar(on){document.getElementById('sidebar').classList.toggle('-translate-x-full',!on);document.getElementById('backdrop').classList.toggle('hidden',!on)}
function loading(on){document.getElementById('loader').classList.toggle('z-hide',!on)}
async function call(n,p){return window.etosSupabaseDirect.invoke(n,p)}
async function boot(){loading(true);try{[S.stats,S.awardees,S.academic,S.achievements,S.cmd]=await Promise.all([call('getDashboardStats'),call('getAwardeeList'),call('getAkademikList'),call('getPrestasiList'),call('getMentoringCommandCenter')]);const perf=window.etosSupabaseDirect.performance();if(perf.lastMs!=null){document.getElementById('ms').textContent=perf.lastMs+' ms';document.getElementById('perf').classList.remove('hidden')}render()}catch(e){document.getElementById('content').innerHTML=errorBox(e.message)}finally{loading(false)}}
function errorBox(m){return `<div class="card-clean p-8 border-red-100"><h3 class="font-extrabold text-red-600">Data belum dapat dimuat</h3><p class="text-sm text-slate-500 mt-2">${esc(m)}</p></div>`}
function setView(v){S.view=v;document.querySelectorAll('.nav').forEach(b=>{const on=b.dataset.v===v;b.classList.toggle('text-etos-main',on);b.classList.toggle('bg-green-50/50',on);b.classList.toggle('font-bold',on);b.classList.toggle('text-slate-500',!on)});toggleSidebar(false);render()}
document.querySelectorAll('.nav').forEach(b=>b.addEventListener('click',()=>setView(b.dataset.v)));
function query(){return (document.getElementById('globalSearch')?.value||'').toLowerCase().trim()}
function head(title,sub,actions=''){return `<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6"><div><h2 class="text-3xl font-extrabold text-slate-800 tracking-tight">${title}</h2><p class="text-slate-500 text-sm mt-1">${sub}</p></div>${actions}</div>`}
function stat(label,val,icon,primary=false,hint=''){return `<div class="${primary?'card-primary':'card-clean'} p-6 min-h-[145px] flex flex-col justify-between"><div class="flex justify-between"><p class="text-sm font-bold ${primary?'text-white/85':'text-slate-700'}">${label}</p><i data-lucide="${icon}" class="w-5 h-5 ${primary?'text-white/70':'text-slate-400'}"></i></div><div><p class="text-5xl font-black">${fmt(val)}</p><p class="text-[11px] ${primary?'text-green-100':'text-slate-500'} mt-2">${hint}</p></div></div>`}
function empty(msg){return `<div class="py-10 text-center text-sm font-semibold text-slate-400">${msg}</div>`}
function dashboard(){const c=S.cmd||{summary:{},attention:[],upcomingActions:[],cohorts:[]},sm=c.summary||{};return head('Dashboard','Prioritaskan dukungan, lihat perkembangan, dan tindak lanjuti kebutuhan awardee dari satu tempat.',`<div class="flex gap-2"><button onclick="refreshAll()" class="bg-white border border-slate-200 px-4 py-2.5 rounded-full text-sm font-bold">Perbarui</button><button onclick="setView('directory')" class="bg-etos-main text-white px-5 py-2.5 rounded-full text-sm font-bold">+ Add Awardee</button></div>`)+`<div class="mb-4"><p class="text-[11px] font-extrabold uppercase tracking-[.16em] text-etos-main">Development Command Center</p><p class="text-xs text-slate-500 mt-1">Sinyal pendampingan dari data Supabase terbaru.</p></div><div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">${stat('Awardee Aktif',S.stats?.aktif,'users',true,'Basis pendampingan aktif')}${stat('Needs Attention',sm.needs_attention??0,'radar',false,'Early support')}${stat('RTL Overdue',sm.rtl_overdue??0,'clock-alert',false,'Tindak lanjut')}${stat('Positive Momentum',sm.positive_momentum??0,'trending-up',false,'Tren perkembangan')}</div><div class="grid grid-cols-1 xl:grid-cols-3 gap-5 mt-5"><section class="card-clean xl:col-span-2 overflow-hidden"><div class="p-5 border-b border-slate-100"><h3 class="font-extrabold">Needs Attention</h3><p class="text-xs text-slate-500 mt-1">Sinyal untuk memprioritaskan dukungan, bukan label baik/buruk.</p></div>${(c.attention||[]).length?'<div></div>':empty('Belum ada sinyal perhatian pada periode aktif.')}</section><section class="card-clean overflow-hidden"><div class="p-5 border-b border-slate-100"><h3 class="font-extrabold">Upcoming Actions</h3><p class="text-xs text-slate-500 mt-1">RTL dan case yang perlu ditindaklanjuti.</p></div>${(c.upcomingActions||[]).length?'<div></div>':empty('Belum ada action aktif.')}</section></div><div class="grid grid-cols-1 xl:grid-cols-3 gap-5 mt-5"><section class="card-clean p-5 xl:col-span-2"><h3 class="font-extrabold">Awardee Quick View